{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@cutbray/shared/*": ["packages/shared/src/*"],
      "@cutbray/ui/*": ["packages/ui/src/*"],
      "@cutbray/config/*": ["packages/config/*"]
    }
  },
  "exclude": ["node_modules", "dist", "build", ".next", ".turbo"]
}
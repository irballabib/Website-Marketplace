# App
NODE_ENV=development
API_PORT=3001
WEB_PORT=3000
POS_PORT=3002

# Database (PostgreSQL 16 via Laragon)
DATABASE_URL="postgresql://postgres@localhost:5432/cutbray_dev?schema=public"

# Redis 7 via Laragon
REDIS_URL="redis://localhost:6379"

# Auth
JWT_SECRET="dev-secret-change-in-production-min-32-chars"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# File Storage (Mock adapter - saves to ./storage)
STORAGE_ADAPTER=mock
STORAGE_LOCAL_PATH="./storage"

# Email (Mock adapter - logs to console)
EMAIL_ADAPTER=mock
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@cutbray.local"

# Payment (Mock gateway by default)
PAYMENT_ADAPTER=mock
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"

# Shipping (Mock adapter)
SHIPPING_ADAPTER=mock
BITESHIP_API_KEY=""

# WhatsApp (Mock adapter)
WHATSAPP_ADAPTER=mock
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Web Push
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@cutbray.local"

# QR Code
QR_BASE_URL="http://localhost:3000"

# MinIO (not used with mock adapter)
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_ACCESS_KEY=""
MINIO_SECRET_KEY=""
MINIO_BUCKET="cutbray"
MINIO_USE_SSL="false"
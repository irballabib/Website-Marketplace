{
  "$schema": "https://turbo.build/schema.json",
  "pipeline": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "outputs": []
    },
    "test": {
      "outputs": ["coverage/**"],
      "dependsOn": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "outputs": ["prisma/client/**"]
    },
    "db:push": {
      "outputs": []
    },
    "db:migrate": {
      "outputs": ["prisma/migrations/**"]
    },
    "db:seed": {
      "outputs": []
    }
  },
  "globalEnv": ["DATABASE_URL", "NODE_ENV"]
}
// Prisma Schema - Fase 0: Initial setup with core models
// This will be expanded in Fase 1+

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// PLATFORM / TENANCY
// ============================================

model Tenant {
  id        String   @id @default(uuid()) @map("tenant_id")
  name      String
  code      String   @unique
  settings  Json     @default("{}")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([code])
  @@map("tenants")
}

model OutboxEvent {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  aggregateId   String   @map("aggregate_id")
  aggregateType String   @map("aggregate_type")
  eventType     String   @map("event_type")
  payload       Json
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at")
  processedAt   DateTime? @map("processed_at")

  @@index([tenantId, createdAt])
  @@index([processedAt])
  @@map("outbox_events")
}

model IdempotencyKey {
  id        String   @id @map("idempotency_key")
  tenantId  String   @map("tenant_id")
  scope     String
  response  Json?
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  @@unique([tenantId, scope, id])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model QRLink {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  code      String   @unique
  targetUrl String   @map("target_url")
  params    Json?
  isActive  Boolean  @default(true)
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  @@index([tenantId, isActive])
  @@map("qr_links")
}

// ============================================
// PAYMENT
// ============================================

model Payment {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  orderId          String?   @map("order_id")
  bookingId        String?   @map("booking_id")
  gatewayReference String?   @map("gateway_reference")
  snapToken        String?   @map("snap_token")
  redirectUrl      String?   @map("redirect_url")
  amount           Decimal   @db.Decimal(18, 2)
  currency         String    @default("IDR")
  method           String    // CASH, QRIS, TRANSFER, EDC
  status           String    @default("PENDING") // PENDING, PAID, FAILED, EXPIRED
  idempotencyKey   String?   @map("idempotency_key")
  paidAt           DateTime? @map("paid_at")
  expiresAt        DateTime? @map("expires_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  createdBy        String?   @map("created_by")
  deletedAt        DateTime? @map("deleted_at")

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, orderId])
  @@index([tenantId, status])
  @@index([gatewayReference])
  @@map("payments")
}

// ============================================
// ORDER
// ============================================

model Order {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  orderNumber     String    @map("order_number")
  idempotencyKey  String?   @map("idempotency_key")
  status          String    @default("PENDING_PAYMENT") // PENDING_PAYMENT, PAID, PROCESSING, PACKED, SHIPPED, COMPLETED, CANCELLED, RETURNED
  channel         String    @default("ONLINE") // ONLINE, POS
  locationId      String    @map("location_id")
  qrCode          String?   @map("qr_code")
  customerName    String    @map("customer_name")
  customerPhone   String?   @map("customer_phone")
  customerEmail   String?   @map("customer_email")
  fulfillmentType String    @map("fulfillment_type") // SHIP, PICKUP
  shippingAddress String?   @map("shipping_address")
  subtotal        Decimal   @db.Decimal(18, 2)
  discount        Decimal   @default(0) @db.Decimal(18, 2)
  shippingCost    Decimal   @default(0) @db.Decimal(18, 2) @map("shipping_cost")
  total           Decimal   @db.Decimal(18, 2)
  currency        String    @default("IDR")
  expiresAt       DateTime  @map("expires_at")
  paidAt          DateTime? @map("paid_at")
  shippedAt       DateTime? @map("shipped_at")
  completedAt     DateTime? @map("completed_at")
  courier         String?
  trackingNumber  String?   @map("tracking_number")
  cancelledAt     DateTime? @map("cancelled_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  createdBy       String?   @map("created_by")
  deletedAt       DateTime? @map("deleted_at")

  location        Location   @relation(fields: [locationId], references: [id])
  items           OrderItem[]

  @@unique([tenantId, orderNumber])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, expiresAt])
  @@index([tenantId, createdAt])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  orderId     String   @map("order_id")
  variantId   String   @map("variant_id")
  productName String   @map("product_name")
  sku         String
  qty         Int
  unitPrice   Decimal  @db.Decimal(18, 2) @map("unit_price")
  total       Decimal  @db.Decimal(18, 2)
  createdAt   DateTime @default(now()) @map("created_at")

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant     Variant  @relation(fields: [variantId], references: [id])

  @@index([tenantId, orderId])
  @@map("order_items")
}

// ============================================
// POS
// ============================================

model PosShift {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  locationId    String    @map("location_id")
  cashierId     String    @map("cashier_id")
  status        String    @default("OPEN") // OPEN, CLOSED
  openingCash   Decimal   @db.Decimal(18, 2) @map("opening_cash")
  closingCash   Decimal?  @db.Decimal(18, 2) @map("closing_cash")
  expectedCash  Decimal?  @db.Decimal(18, 2) @map("expected_cash")
  difference    Decimal?  @db.Decimal(18, 2)
  openedAt      DateTime  @default(now()) @map("opened_at")
  closedAt      DateTime? @map("closed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  sales         PosSale[]

  @@index([tenantId, locationId, status])
  @@index([tenantId, cashierId, status])
  @@map("pos_shifts")
}

model PosSale {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  locationId     String    @map("location_id")
  shiftId        String    @map("shift_id")
  cashierId      String    @map("cashier_id")
  receiptNumber  String    @map("receipt_number")
  idempotencyKey String    @map("idempotency_key")
  status         String    @default("COMPLETED") // COMPLETED, VOID
  customerName   String?   @map("customer_name")
  subtotal       Decimal   @db.Decimal(18, 2)
  discount       Decimal   @default(0) @db.Decimal(18, 2)
  total          Decimal   @db.Decimal(18, 2)
  paymentTotal   Decimal   @db.Decimal(18, 2) @map("payment_total")
  voidedAt       DateTime? @map("voided_at")
  voidReason     String?   @map("void_reason")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  shift          PosShift      @relation(fields: [shiftId], references: [id])
  items          PosSaleItem[]
  payments       PosPayment[]

  @@unique([tenantId, receiptNumber])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, locationId, createdAt])
  @@index([tenantId, shiftId])
  @@map("pos_sales")
}

model PosSaleItem {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  saleId      String   @map("sale_id")
  variantId   String   @map("variant_id")
  productName String   @map("product_name")
  sku         String
  qty         Int
  unitPrice   Decimal  @db.Decimal(18, 2) @map("unit_price")
  total       Decimal  @db.Decimal(18, 2)

  sale        PosSale  @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([tenantId, saleId])
  @@map("pos_sale_items")
}

model PosPayment {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  saleId      String   @map("sale_id")
  method      String   // CASH, QRIS, TRANSFER, EDC
  amount      Decimal  @db.Decimal(18, 2)
  reference   String?
  createdAt   DateTime @default(now()) @map("created_at")

  sale        PosSale  @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([tenantId, saleId])
  @@map("pos_payments")
}

model PosSequence {
  id         String @id @default(uuid())
  tenantId   String @map("tenant_id")
  locationId String @map("location_id")
  lastNumber Int    @default(0) @map("last_number")

  @@unique([tenantId, locationId])
  @@map("pos_sequences")
}

// ============================================
// IDENTITY
// ============================================

model User {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  email         String
  phone         String?
  passwordHash  String   @map("password_hash")
  pinHash       String?  @map("pin_hash")
  fullName      String   @map("full_name")
  avatarUrl     String?  @map("avatar_url")
  isActive      Boolean  @default(true)
  isVerified    Boolean  @default(false) @map("is_verified")
  twoFactorEnabled Boolean @default(false) @map("two_factor_enabled")
  twoFactorSecret  String? @map("two_factor_secret")
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  roles         UserRole[]

  @@unique([tenantId, email])
  @@unique([tenantId, phone])
  @@index([tenantId, isActive])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       UserRole[]
  permissions RolePermission[]

  @@unique([tenantId, name])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  category    String
  createdAt   DateTime @default(now()) @map("created_at")

  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  tenantId  String   @map("tenant_id")
  assignedBy String? @map("assigned_by")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, tenantId])
  @@index([tenantId])
  @@map("user_roles")
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  tenantId     String   @map("tenant_id")
  createdAt    DateTime @default(now()) @map("created_at")

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId, tenantId])
  @@map("role_permissions")
}

model Session {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  tenantId        String   @map("tenant_id")
  refreshTokenHash String  @unique @map("refresh_token_hash")
  userAgent       String?  @map("user_agent")
  ipAddress       String?  @map("ip_address")
  expiresAt       DateTime @map("expires_at")
  createdAt       DateTime @default(now()) @map("created_at")
  revokedAt       DateTime? @map("revoked_at")

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String   @map("entity_id")
  oldData   Json?
  newData   Json?
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// ============================================
// CATALOG (placeholder - expanded in Fase 1)
// ============================================

model Category {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  parentId  String?  @map("parent_id")
  name      String
  slug      String
  imageUrl  String?  @map("image_url")
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  parent    Category?    @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[]   @relation("CategoryHierarchy")
  products  Product[]

  @@unique([tenantId, slug])
  @@index([tenantId, parentId])
  @@map("categories")
}

model Product {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  categoryId  String   @map("category_id")
  name        String
  slug        String
  description String?
  skuPrefix   String   @map("sku_prefix")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  category    Category   @relation(fields: [categoryId], references: [id])
  variants    Variant[]
  media       ProductMedia[]

  @@unique([tenantId, slug])
  @@index([tenantId, isActive])
  @@map("products")
}

model ProductMedia {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  url       String
  alt       String?
  sortOrder Int      @default(0) @map("sort_order")
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_media")
}

model Variant {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  productId   String   @map("product_id")
  sku         String   @unique
  barcode     String?  @unique
  color       String
  size        String
  price       Decimal  @db.Decimal(18, 2)
  costPrice   Decimal? @db.Decimal(18, 2) @map("cost_price")
  weight      Decimal? @db.Decimal(10, 3)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockLedger StockLedger[]
  stockBalances StockBalance[]
  orderItems  OrderItem[]

  @@unique([tenantId, sku])
  @@index([tenantId, productId])
  @@index([tenantId, barcode])
  @@map("variants")
}

// ============================================
// INVENTORY (placeholder - expanded in Fase 1)
// ============================================

model Location {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  code      String
  name      String
  type      String   // WAREHOUSE, STORE, BAZAAR, PRODUCTION
  address   String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  stockBalances StockBalance[]
  stockLedger   StockLedger[]
  orders        Order[]

  @@unique([tenantId, code])
  @@map("locations")
}

model StockLedger {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  variantId       String   @map("variant_id")
  locationId      String   @map("location_id")
  movementType    String   @map("movement_type") // RESERVATION, COMMIT, RELEASE, ADJUSTMENT, TRANSFER_IN, TRANSFER_OUT, OPNAME, PRODUCTION_IN, PRODUCTION_OUT
  qtyDelta        Decimal  @default(0) @db.Decimal(18, 4) @map("qty_delta")
  qtyReservedDelta Decimal @default(0) @db.Decimal(18, 4) @map("qty_reserved_delta")
  referenceId     String?  @map("reference_id") // order_id, booking_id, work_order_id, adjustment_id
  referenceType   String?  @map("reference_type")
  note            String?
  createdBy       String   @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")

  variant         Variant  @relation(fields: [variantId], references: [id])
  location        Location @relation(fields: [locationId], references: [id])

  @@index([tenantId, variantId, locationId, createdAt])
  @@index([tenantId, referenceId, referenceType])
  @@map("stock_ledger")
}

model StockBalance {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  variantId String   @map("variant_id")
  locationId String  @map("location_id")
  qtyOnHand Decimal  @default(0) @db.Decimal(18, 4) @map("qty_on_hand")
  qtyReserved Decimal @default(0) @db.Decimal(18, 4) @map("qty_reserved")
  updatedAt DateTime @updatedAt @map("updated_at")

  variant   Variant  @relation(fields: [variantId], references: [id])
  location  Location @relation(fields: [locationId], references: [id])

  @@unique([tenantId, variantId, locationId])
  @@map("stock_balances")
}

// ============================================
// ACCOUNTING (placeholder - expanded in Fase 4)
// ============================================

model Account {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  code        String
  name        String
  type        String   // ASSET, LIABILITY, EQUITY, REVENUE, COGS, EXPENSE
  parentId    String?  @map("parent_id")
  isActive    Boolean  @default(true) @map("is_active")
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  parent      Account?   @relation("AccountHierarchy", fields: [parentId], references: [id])
  children    Account[]  @relation("AccountHierarchy")
  journalLines JournalLine[]

  @@unique([tenantId, code])
  @@index([tenantId, type])
  @@map("accounts")
}

model JournalEntry {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  entryNumber String   @map("entry_number")
  date        DateTime @db.Date
  description String
  referenceId String?  @map("reference_id")
  referenceType String? @map("reference_type")
  status      String   @default("POSTED") // DRAFT, POSTED, REVERSED
  postedBy    String?  @map("posted_by")
  postedAt    DateTime? @map("posted_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  lines       JournalLine[]

  @@unique([tenantId, entryNumber])
  @@unique([tenantId, referenceType, referenceId])
  @@index([tenantId, date])
  @@index([tenantId, status])
  @@map("journal_entries")
}

model AccountingSequence {
  id         String @id @default(uuid())
  tenantId   String @map("tenant_id")
  lastNumber Int    @default(0) @map("last_number")

  @@unique([tenantId])
  @@map("accounting_sequences")
}

model JournalLine {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  journalEntryId String  @map("journal_entry_id")
  accountId     String   @map("account_id")
  debit         Decimal  @default(0) @db.Decimal(18, 2)
  credit        Decimal  @default(0) @db.Decimal(18, 2)
  description   String?
  createdAt     DateTime @default(now()) @map("created_at")

  journalEntry  JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account       Account      @relation(fields: [accountId], references: [id])

  @@index([tenantId, accountId])
  @@index([journalEntryId])
  @@map("journal_lines")
}

// ============================================
// SETTINGS
// ============================================

model Setting {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  key       String
  value     Json
  scope     String   @default("global") // global, catalog, inventory, accounting, pos, booking, production
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, scope, key])
  @@map("settings")
}